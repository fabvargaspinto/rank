# Copiar a deploy/backend.env (permisos 600). No commitear el .env real.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
EMAIL_ENCRYPTION_KEY=
EMAIL_HMAC_KEY=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Debe coincidir con Valid OAuth Redirect URIs en Meta.
INSTAGRAM_REDIRECT_URI=https://<dominio>/auth/instagram/callback
# En Meta: Deauthorize = https://<dominio>/instagram/deauthorize
# y Data deletion = https://<dominio>/instagram/data-deletion
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
# Instagram Analytics (Turso). ensure_schema hace CREATE/ALTER al arrancar → el token
# tiene que ser full-access de ESA base, no de grupo/organización:
#   turso db tokens create <nombre-base>
# Anotá fecha de rotación (p. ej. cada 90 días) en el gestor de secretos.
TURSO_URL=
TURSO_TOKEN=
# TURSO_TOKEN_ROTATE_BY=YYYY-MM-DD
