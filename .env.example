SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
# Los tests de integración ignoran estas variables y usan Supabase local
# en Docker (http://127.0.0.1:54321). Levantar: pnpm --dir frontend supabase:start
EMAIL_ENCRYPTION_KEY=
EMAIL_HMAC_KEY=
BACKEND_URL=https://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Instagram Analytics (bounded context propio; no usar Supabase)
# Usá el Instagram App ID / Secret de Meta → Instagram → API setup with Instagram login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Debe coincidir exactamente con Meta → Instagram business login → OAuth redirect URIs.
# Meta suele exigir https://. Con docker compose + certs en backend/certs funciona en local.
INSTAGRAM_REDIRECT_URI=https://localhost:8000/instagram/oauth/callback
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
INSTAGRAM_SNAPSHOT_JOB_TOKEN=

# Turso Cloud. Para desarrollo local sin Turso, usar un archivo SQLite:
# TURSO_URL=file:./instagram.db
# TURSO_TOKEN=
TURSO_URL=
TURSO_TOKEN=
