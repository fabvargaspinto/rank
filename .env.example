SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_ANON_KEY=
# Proyecto hosted de desarrollo (recomendado para tests de integración).
# Si está definido, los tests usan esto en lugar de Supabase local / producción.
SUPABASE_DEVELOPMENT_URL=
SUPABASE_DEVELOPMENT_SECRET_KEY=
SUPABASE_DEVELOPMENT_ANON_KEY=
# Sin SUPABASE_DEVELOPMENT_*, los tests caen a Supabase local en Docker
# (http://127.0.0.1:54321). Levantar: pnpm --dir frontend supabase:start
# 32 bytes hex cada una. Generar: openssl rand -hex 32
# Producción: claves nuevas (no las de desarrollo). Prefijo v1: + AAD por fila en el código.
EMAIL_ENCRYPTION_KEY=
EMAIL_HMAC_KEY=
BACKEND_URL=https://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend SMTP local (supabase/config.toml). Key de desarrollo; no la de producción.
RESEND_API_KEY=
# Local sin dominio: beth.t@example.com. Hosted: casilla del dominio verificado (obligatoria en configure-resend-smtp.sh).
RESEND_FROM_EMAIL=beth.t@example.com
# Email de tu cuenta Resend (único destinatario sin dominio verificado)
EMAIL_RECIPIENT=
# EMAIL_DEVELOPMENT_RECIPIENT=
# Token de cuenta para scripts hosted: https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=

# Google OAuth: NO va en la app. Configurar en Supabase Auth (dashboard) o:
#   GOOGLE_CLIENT_ID=… GOOGLE_CLIENT_SECRET=… ./scripts/configure-supabase-google-oauth.sh
# Redirect en Google Cloud: https://<PROJECT_REF>.supabase.co/auth/v1/callback

# Instagram Analytics (bounded context propio; no usar Supabase)
# Usá el Instagram App ID / Secret de Meta → Instagram → API setup with Instagram login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Debe coincidir exactamente con Meta → Instagram business login → OAuth redirect URIs.
# Meta suele exigir https://. En local: el callback es de Next (/auth/instagram/callback).
INSTAGRAM_REDIRECT_URI=http://localhost:3000/auth/instagram/callback
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
# openssl rand -hex 32 — distinta de EMAIL_* en producción
INSTAGRAM_SNAPSHOT_JOB_TOKEN=

# Turso local / docker compose. Producción va en deploy/backend.env, no acá.
# docker-compose.yml usa TURSO_DEVELOPMENT_* si está; si no, file:./instagram.db.
TURSO_URL=file:./instagram.db
TURSO_TOKEN=
# Base Turso de desarrollo (compose + tests de integración de Instagram)
TURSO_DEVELOPMENT_URL=
TURSO_DEVELOPMENT_TOKEN=
# Alias opcional de TURSO_DEVELOPMENT_URL
# TURSO_DEVELOPMENT_DATABASE=
